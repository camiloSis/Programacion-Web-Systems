                  "pm.test('Respuesta tiene status success', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('Todos los cursos tienen 4 créditos', function () {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(curso => {",
                  "        pm.expect(curso.creditos).to.eql(4);",
                  "    });",
                  "});",
