        {
          "name": "Listar todos los cursos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta tiene status success', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('Data es un array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Array no está vacío (al menos 5 cursos iniciales)', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.gte(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
